generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PLUS
  PRO
}

enum ApplicationStatus {
  PENDING
  APPLYING
  SENT
  FAILED
  VIEWED
  SKIPPED
}

enum ApplyType {
  EASY_APPLY
  EXTERNAL
}

enum LogAction {
  SCRAPE
  MATCH
  FILL_FORM
  SUBMIT
  SCREENSHOT
}

model User {
  id                String        @id @default(cuid())
  supabaseId        String        @unique
  email             String        @unique
  name              String
  phone             String?
  zipCode           String?
  linkedinUrl       String?
  desiredRole       String?
  cvUrl             String?
  plan              Plan          @default(FREE)
  dailyQuota        Int           @default(1)
  emailDigest       Boolean       @default(true)
  emailOnViewed     Boolean       @default(true)
  emailOnFailed     Boolean       @default(true)
  automationPaused    Boolean       @default(false)
  lastPipelineRunAt   DateTime?
  scheduleDays        Int[]         @default([1, 2, 3, 4, 5])
  scheduleTime        String?
  excludeCompanies    String[]      @default([])
  minSalary           Float?
  createdAt           DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  skills            Skill[]
  applications      Application[]
}

model Skill {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
  @@index([userId])
}

model Job {
  id           String        @id @default(cuid())
  title        String
  company      String
  location     String?
  salary       Float?
  description  String?
  linkedinUrl  String        @unique
  requirements String[]
  remote       Boolean       @default(false)
  applyType    ApplyType     @default(EASY_APPLY)
  applications Application[]

  @@index([linkedinUrl])
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  jobId      String
  status     ApplicationStatus @default(PENDING)
  matchScore Float             @default(0)
  appliedAt  DateTime?
  errorLog   String?
  failReason String?
  directUrl  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job               @relation(fields: [jobId], references: [id])
  logs       ApplicationLog[]

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([createdAt])
}

model ApplicationLog {
  id            String      @id @default(cuid())
  applicationId String
  action        LogAction
  detail        Json?
  screenshotUrl String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
}
